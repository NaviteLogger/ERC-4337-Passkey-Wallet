# Pimlico bundler RPC URL. Get one free at https://dashboard.pimlico.io/.
# Falls back to a public placeholder if unset; sending real UserOps requires this.
NEXT_PUBLIC_BUNDLER_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=YOUR_KEY

# WalletConnect project id — for RainbowKit. Get one at https://cloud.walletconnect.com/.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Address of PasskeyAccountFactory deployed on Sepolia (or your target chain).
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000

# Address of SponsorPaymaster on the same chain.
NEXT_PUBLIC_PAYMASTER_ADDRESS=0x0000000000000000000000000000000000000000

# Sponsor service URL — the dashboard proxies through Next.js, so localhost is fine in dev.
SPONSOR_SERVICE_URL=http://localhost:4000

# Chain id (default Sepolia).
NEXT_PUBLIC_CHAIN_ID=11155111
